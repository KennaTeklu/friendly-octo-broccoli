    <!--P4:HEAD:BEG-->
<!-- P4 head: fonts + theme flash prevention (applied before first paint) -->
    <!--P4:HEAD:BEG-->

<!-- P4 head: fonts + theme flash prevention (applied before first paint) -->

<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<script>

/* P4 theme boot — runs before paint to prevent flash of wrong theme */

(function(){

  try {

    var raw = localStorage.getItem('p4_theme');

    var t = raw ? JSON.parse(raw) : null;

    var mode = (t && t.mode) ? t.mode : 'dark';

    var accent = (t && t.accent) ? t.accent : 'blue';

    if (mode === 'auto') {

      mode = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';

    }

    var root = document.documentElement;

    root.setAttribute('data-mode', mode);

    root.setAttribute('data-accent', accent);

    if (mode === 'dark') { root.setAttribute('data-theme', 'dark'); }

    else if (['blue','green','purple','orange'].indexOf(accent) !== -1) { root.setAttribute('data-theme', accent); }

    var gym = localStorage.getItem('p4_gym');

    if (gym === 'on') { root.setAttribute('data-gym', 'on'); }

  } catch(e){}

})();

</script>

<!--P4:HEAD:END-->

<!-- ===== MODULAR CSS (extracted from index (24).html) ===== -->
<link rel="stylesheet" href="styles/base.css">
<link rel="stylesheet" href="styles/components.css">
<link rel="stylesheet" href="styles/sections.css">
<link rel="stylesheet" href="styles/themes.css">

<!-- ===== Storage probe + loader (inline, runs before body renders) ===== -->
    <script>

window.STORAGE_ENABLED = false;

try {

    localStorage.setItem('probe', '1');

    localStorage.removeItem('probe');

    // Also check IndexedDB

    window.indexedDB.open('probe_db', 1).onsuccess = (e) => {

        e.target.result.close();

        window.STORAGE_ENABLED = true;

    };

} catch (e) {

    console.warn("Storage is blocked in this environment.");

}

    (function() {

        // Show loader immediately

        const loader = document.getElementById('loading');

        if (loader) loader.classList.add('active');

        document.body.classList.add('loading');



        // Hide loader function

        const hideLoader = () => {

            if (!loader) return;

            loader.style.transition = 'opacity 0.3s';

            loader.style.opacity = '0';

            setTimeout(() => {

                loader.classList.remove('active');

                loader.style.opacity = '';

                loader.style.display = 'none';

                document.body.classList.remove('loading');

            }, 300);

        };



        // Deadman's switch – 10 seconds (generous for slow iframes)

        const deadmanTimeout = setTimeout(() => {

            hideLoader();

            const banner = document.createElement('div');

            banner.style.cssText = 'position:fixed; bottom:20px; left:20px; right:20px; background:#ff4444; color:white; padding:12px; border-radius:12px; text-align:center; z-index:10001; font-weight:bold;';

            banner.innerHTML = '⚠️ App took too long to load. Some features may be unavailable. <button onclick="location.reload()" style="background:white; color:#ff4444; border:none; border-radius:20px; padding:4px 12px; margin-left:10px;">Reload</button>';

            document.body.appendChild(banner);

            setTimeout(() => banner.remove(), 8000);

        }, 10000);



        // Success trigger – call this when data is loaded

        window.appReady = function() {

            clearTimeout(deadmanTimeout);

            hideLoader();

        };



        // Redirect to dashboard if no hash

        if (!window.location.hash || window.location.hash === '#') {

            try {

                window.location.replace(window.location.href.split('#')[0] + '#dashboard');

            } catch(e) {

                try { window.location.hash = 'dashboard'; } catch(e2) {}

            }

        }

    })();

    </script>

</head>
<body class="loading">
