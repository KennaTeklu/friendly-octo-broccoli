    <!-- MAIN APPLICATION -->
    <div class="container main-app" id="mainApp">
        <!-- The 7 sections are loaded via fetch() from sections/*.html -->
        <!-- If opened via file:// (no static server), the loader falls back to an inline note. -->
        <include src="sections/dashboard.html"></include>
        <include src="sections/workout.html"></include>
        <include src="sections/history.html"></include>
