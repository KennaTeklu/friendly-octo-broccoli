    <include src="sections/modals.html"></include>

    <!-- ===== Section loader (fetches sections/*.html and replaces <include>) ===== -->
    <script>
(function () {
  var includes = document.querySelectorAll('include');
  var remaining = includes.length;
  if (remaining === 0) return;
  includes.forEach(function (el) {
    var url = el.getAttribute('src');
    fetch(url)
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
      .then(function (html) {
        el.outerHTML = html;  // replace the <include> element entirely
        remaining--;
      })
      .catch(function (err) {
        el.outerHTML = '<div style="padding:20px;background:#fff3cd;color:#856404;border:1px solid #ffeeba;border-radius:8px;margin:10px;">' +
          '<b>Could not load ' + url + '</b><br>' +
          'Open this page via a static server (e.g. <code>python3 -m http.server</code> from the reference/ folder) ' +
          'so the browser allows fetch() of section files.<br>' +
          'Error: ' + (err.message || err) + '</div>';
      });
  });
})();
    </script>

